{
  "app": {
    "signingConfigs": [
      {
        "name": "default",
        "material": {
          "storePassword": "<YOUR_STORE_PASSWORD>",
          "certpath": "<YOUR_CERT_PATH>",
          "keyAlias": "debugKey",
          "keyPassword": "<YOUR_KEY_PASSWORD>",
          "profile": "<YOUR_PROFILE_PATH>",
          "signAlg": "SHA256withECDSA",
          "storeFile": "<YOUR_STORE_FILE_PATH>"
        },
        "type": "HarmonyOS"
      }
    ],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "compileSdkVersion": "6.1.0(23)",
        "compatibleSdkVersion": "6.1.0(23)",
        "targetSdkVersion": "6.1.0(23)",
        "runtimeOS": "HarmonyOS"
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
