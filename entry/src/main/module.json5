{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    // Only 2in1 is declared: the whole residency design depends on the status-bar tray, which exists
    // just on PC/2in1, and no other device type has ever been tested on real hardware.
    "deviceTypes": [
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:entryability_desc",
        // Layered icon: both layers are 1024x1024 with an opaque white background, which is what the
        // app-market check requires. The title bar paints this icon unmasked, so it reads as a white
        // card on dark chrome - this SDK has no per-window icon API to split desktop from title bar.
        "icon": "$media:layered_image",
        "label": "$string:app_name",
        "startWindowIcon": "$media:app_icon",
        "startWindowBackground": "$color:start_window_background",
        "launchType": "singleton",
        "backgroundModes": [
          "taskKeeping",
          "dataTransfer"
        ],
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "TrayPanelAbility",
        "srcEntry": "./ets/statusbar/TrayPanelAbility.ets",
        "description": "$string:entryability_desc",
        "icon": "$media:app_icon",
        "type": "statusBarView",
        "exported": true
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.GET_NETWORK_INFO"
      },
      {
        "name": "ohos.permission.FILE_ACCESS_PERSIST"
      },
      {
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING",
        "reason": "$string:background_running_reason",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "always"
        }
      }
    ]
  }
}